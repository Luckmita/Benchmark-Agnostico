{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Benchmark Agent Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "agent_id",
    "implementation_version",
    "capabilities",
    "entrypoint",
    "dependencies",
    "declared_timeout_seconds",
    "runtime",
    "training_provenance",
    "model_hash",
    "adapter_hash",
    "hardware_requirements"
  ],
  "properties": {
    "manifest_version": { "type": "string", "minLength": 1 },
    "agent_id": { "type": "string", "minLength": 1 },
    "implementation_version": { "type": "string", "minLength": 1 },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["online_learning", "persistence", "uncertainty"],
      "properties": {
        "online_learning": { "type": "boolean" },
        "persistence": { "type": "boolean" },
        "uncertainty": { "type": "boolean" }
      }
    },
    "entrypoint": { "type": "string" },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "declared_timeout_seconds": { "type": "number", "exclusiveMinimum": 0 },
    "runtime": { "type": "string", "minLength": 1 },
    "training_provenance": { "type": "string", "minLength": 1 },
    "model_hash": {
      "type": "string",
      "pattern": "^(not-applicable|not-provided|sha256:[0-9a-f]{64})$"
    },
    "adapter_hash": {
      "type": "string",
      "pattern": "^(not-applicable|not-provided|sha256:[0-9a-f]{64})$"
    },
    "hardware_requirements": { "type": "string", "minLength": 1 }
  }
}
